# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# REQUIRED - Supabase Configuration
# ============================================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================================
# OPTIONAL - Google Calendar Integration
# ============================================================================
# Only needed if you want to sync tasks with Google Calendar
# Get these from: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# ============================================================================
# OPTIONAL - Encryption Key for Calendar Tokens
# ============================================================================
# Only needed if using Google Calendar integration
# Generate with: openssl rand -hex 32
# Or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

ENCRYPTION_KEY=your-32-character-encryption-key-here

# ============================================================================
# OPTIONAL - Cron Job Secret
# ============================================================================
# Only needed for automated jobs in production (recurring tasks, reminders, calendar sync)
# Generate with: openssl rand -hex 32

CRON_SECRET=your-random-secret-here

# ============================================================================
# Production Settings
# ============================================================================
# When deploying to production, update GOOGLE_REDIRECT_URI to:
# GOOGLE_REDIRECT_URI=https://yourdomain.com/api/calendar/callback

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Copy this file: cp env.template .env.local
# 2. Fill in your Supabase credentials (required)
# 3. If using Google Calendar, fill in Google OAuth credentials
# 4. Generate encryption key if using Google Calendar
# 5. Never commit .env.local to git (it's in .gitignore)
